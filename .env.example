# Supabase — BinestarRD (project ref: nigjhvhpyowruhxytdpy, region us-east-1)
# Copy to .env.local and fill in. Never commit .env.local.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://nigjhvhpyowruhxytdpy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Canonical site origin, used to build the magic-link redirect (auth callback).
# Locally this can be omitted (falls back to the request origin / localhost:3000).
# In production set it to the deployed URL, e.g. https://bienestar.rd
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — DO NOT expose to the browser, do not commit the real value.
# Get from Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
